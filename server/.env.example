# Entorno: pon production al desplegar (activa las comprobaciones de seguridad)
NODE_ENV=development
# Puerto de la API en desarrollo (en producción se usa PORT, que pone el proveedor)
API_PORT=3001
# Secreto para firmar los tokens JWT (obligatorio en producción, mínimo 32 caracteres)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Orígenes permitidos para CORS, separados por comas
CLIENT_ORIGIN=http://localhost:5173
# PostgreSQL en la nube (Neon, Supabase...). Si se deja vacío se usa PGlite en ./data
DATABASE_URL=
